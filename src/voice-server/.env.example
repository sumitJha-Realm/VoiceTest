# ── Sarvam AI ──────────────────────────────────────────────────────────────
# Get your key from https://dashboard.sarvam.ai (free signup credits).
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_BASE_URL=https://api.sarvam.ai

# Model IDs — current non-deprecated models (verify in the dashboard).
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_LLM_MODEL=sarvam-105b
SARVAM_TTS_SPEAKER=priya

# ── Server ─────────────────────────────────────────────────────────────────
PORT=7860
# Comma-separated list of allowed frontend origins, or * for demo.
ALLOWED_ORIGINS=*

# ── Agentic workflow (optional) ────────────────────────────────────────────
# Paste the Production webhook URL from your n8n collections workflow.
N8N_WEBHOOK_URL=

# ── Google Sheets CRM (optional) ───────────────────────────────────────────
# Leave blank to use the built-in in-memory CRM (zero setup).
GOOGLE_SHEET_ID=
GOOGLE_CREDS_FILE=./service-account.json
GOOGLE_CRM_SHEET_NAME=Collections
GOOGLE_BORROWERS_SHEET_NAME=Borrowers
GOOGLE_BORROWERS_CACHE_TTL_SEC=30
